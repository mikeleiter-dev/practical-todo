{
  "name": "practical-todo",
  "version": "0.1.0",
  "private": true,
  "description": "Personal to-do app: see what you're working on, snooze the rest, see what you keep putting off.",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "demo": "PRACTICAL_TODO_DEMO=1 node server.js",
    "test": "node --test test/",
    "app": "bin/practical-todo",
    "app:install": "bash scripts/install-app.sh",
    "app:uninstall": "bash scripts/uninstall-app.sh",
    "import": "node scripts/import-seed.js",
    "check:data": "node scripts/check-no-real-data.js"
  },
  "engines": {
    "node": ">=20"
  }
}
